# Demo settings. Read by the Makefile and by every script in scripts/.
# Plain KEY=value lines only: no quotes, no spaces, no trailing comments.
# Override any of them per command, e.g.  make overhead OVERHEAD_SERVICES=cart

# Local kind cluster (kind/cluster.yaml). Leave KIND_NODE_IMAGE empty for
# kind's default Kubernetes version, or pin one, e.g. kindest/node:v1.34.0
KIND_CLUSTER=kubecon-sampling
KIND_NODE_IMAGE=

# Scripts refuse to touch any other kubectl context. Empty = allow any cluster.
KUBE_CONTEXT=kind-kubecon-sampling

# Where the demo runs
NAMESPACE=otel-demo
RELEASE=astro

# Pinned charts. Demo chart 0.42.6 = OTel Demo 3.1.0 + Collector 0.160.0 (contrib).
# The gateway uses the same collector chart version the demo chart pins,
# so both tiers run the same Collector binary.
DEMO_CHART_VERSION=0.42.6
GATEWAY_RELEASE=otel-gateway
GATEWAY_CHART_VERSION=0.173.1

# Perses (live dashboard). Dashboard and datasources are in perses/.
PERSES_IMAGE=quay.io/persesdev/perses:v0.55.1

# Feature flag used for the "same failure, lost then kept" moment
FLAG_NAME=paymentFailure
FLAG_VARIANT=100%
FLAG_MINUTES=5

# Dry-run protocol: run each stage 15 min, discard the first 5, keep the median of the last 10
WARMUP_MIN=5
MEASURE_MIN=10

# Services for the in-process overhead comparison (Go, Java, .NET).
# Language decides how "SDK off" is done, see scripts/overhead.sh
OVERHEAD_SERVICES=checkout,ad,cart

# Local ports for the port-forwards
PORT_SHOP=8080
PORT_PERSES=8090
PORT_JAEGER=16686
PORT_PROMETHEUS=9090
